PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/task_workflow_platform
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=workflowhq_refresh
CORS_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
DEMO_USER_NAME=WorkflowHQ Demo
DEMO_USER_EMAIL=demo@workflowhq.app
DEMO_USER_PASSWORD=WorkflowHQ!2026
ALLOW_DEMO_SEED=false

# Keep disabled until the server-only GitHub App secrets are configured.
GITHUB_INTEGRATION_ENABLED=false
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=workflowhq
# GITHUB_APP_CLIENT_ID=Iv1.example
# GITHUB_APP_CLIENT_SECRET=replace_with_render_secret
# GITHUB_APP_PRIVATE_KEY_BASE64=base64_encoded_pem_from_render_secret_file
# GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
GITHUB_API_VERSION=2026-03-10
GITHUB_CONNECT_STATE_TTL_MINUTES=10

# Project invitation links use the deployed frontend URL. Email delivery remains
# disabled until a verified sender and a server-only Resend key are configured.
APP_BASE_URL=http://localhost:5173
INVITATION_EMAIL_PROVIDER=disabled
INVITATION_TTL_HOURS=168
# INVITATION_FROM_EMAIL=WorkflowHQ <invites@your-domain.example>
# RESEND_API_KEY=re_server_only_secret

