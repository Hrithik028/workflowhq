{
  "name": "workflowhq-backend",
  "version": "1.0.0",
  "description": "REST API for WorkflowHQ.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrationStatus.js",
    "seed:demo": "node src/db/seedDemo.js",
    "admin:promote": "node src/db/promoteAdmin.js",
    "owner:assign": "node src/db/assignPlatformOwner.js",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "express",
    "postgresql",
    "jwt",
    "portfolio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "globals": "^17.12.0",
    "nodemon": "^3.1.10",
    "pg-mem": "^3.0.5",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "vitest": "^5.0.0"
  }
}
